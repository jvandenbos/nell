pkgname=quire
pkgver=0.2.0
pkgrel=1
pkgdesc='Read EPUB and PDF books, after Apple Books, with the best of Kindle'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'poppler-qt6' 'libarchive' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/quire "$pkgdir/usr/bin/quire"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/quire.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/quire.svg"
  install -Dm644 "$startdir/quire.desktop" "$pkgdir/usr/share/applications/quire.desktop"
}
